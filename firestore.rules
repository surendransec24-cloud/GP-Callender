rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Read Rule: Authenticated users with verified @bitsathy.ac.in email only
    match /{document=**} {
      allow read: if request.auth != null 
                  && request.auth.token.email.matches('.*@bitsathy\\.ac\\.in$') 
                  && request.auth.token.email_verified == true;
    }

    // 2. Write Rule: Restricted to authorized @bitsathy.ac.in administrator emails
    match /gps/{gpId} {
      allow write: if request.auth != null 
                   && request.auth.token.email_verified == true
                   && request.auth.token.email in [
                     'admin@bitsathy.ac.in',
                     'studentcouncil@bitsathy.ac.in',
                     'principal@bitsathy.ac.in',
                     'convenor@bitsathy.ac.in'
                   ];
    }
  }
}

